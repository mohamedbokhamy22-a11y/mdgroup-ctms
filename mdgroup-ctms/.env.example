# MDGroup CTMS — Environment Variables
# Copy this file to .env and fill in your values

# ── Database ───────────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://postgres:password@localhost:5432/mdgroup_ctms?schema=public"

# ── Server ─────────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Authentication ─────────────────────────────────────────────────────────────
# Must be at least 32 characters — generate with: openssl rand -hex 32
JWT_SECRET=your-super-secret-jwt-key-min-32-chars-here
JWT_EXPIRES_IN=7d

# ── Security ───────────────────────────────────────────────────────────────────
BCRYPT_ROUNDS=12
